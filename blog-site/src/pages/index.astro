---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-section" style="padding: 4em 0 2em 0; text-align: center;">
				<h1 style="font-size: 3.5rem; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; margin-bottom: 0.3em;">
					Harshal Nikure
				</h1>
				<p style="font-size: 1.35rem; color: var(--text-title); font-weight: 500; margin-bottom: 1.5em; font-family: var(--font-heading);">
					Cloud & AI Engineer | Specializing in DevOps, Kubernetes, and Generative AI
				</p>
				<p style="max-width: 600px; margin: 0 auto 2.5em auto; opacity: 0.8; font-size: 1.1rem; line-height: 1.7;">
					Welcome to my technical blog. Here, I share in-depth tutorials, architectural reviews, and automation guides focused on building resilient systems and cognitive AI agents.
				</p>
				<div style="display: flex; gap: 1em; justify-content: center;">
					<a href="/blog" style="background: var(--accent-gradient); color: #fff; padding: 0.8em 1.8em; border-radius: 8px; font-weight: 600; font-family: var(--font-heading); box-shadow: var(--box-shadow); transition: transform 0.2s ease;">
						Read the Blog
					</a>
					<a href="/about" style="border: 1px solid var(--border-color); color: var(--text-title); padding: 0.8em 1.8em; border-radius: 8px; font-weight: 600; font-family: var(--font-heading); background: rgba(255, 255, 255, 0.02); transition: all 0.2s ease;">
						About Me
					</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
